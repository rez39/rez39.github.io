<!--
  Local override of al_folio_core's _includes/news.liquid: date shown as
  "Mon YYYY:" inline with the item (matching the site owner's previous
  site), not a separate table column with a full day. Items from before
  2023 are collapsed behind a <details> disclosure. On the about-page
  widget (limited to the most recent N items) the disclosure stays a
  no-op since those items are always 2023+.
-->
<div class="news">
  {% if site.news != blank %}
    {% assign news_size = site.news | size %}
    {% assign news = site.news | reverse %}
    {% if include.limit and page.announcements.limit %}
      {% assign news_limit = page.announcements.limit %}
    {% else %}
      {% assign news_limit = news_size %}
    {% endif %}

    {% assign recent_rows = "" %}
    {% assign older_rows = "" %}
    {% assign shown = 0 %}
    {% for item in news %}
      {% if shown >= news_limit %}
        {% break %}
      {% endif %}
      {% assign shown = shown | plus: 1 %}
      {% assign item_year = item.date | date: "%Y" | plus: 0 %}
      {% capture row %}
        <li>
          <span class="news-date">{{ item.date | date: '%b %Y' }}:</span>
          {% if item.inline %}
            {{ item.content | remove: '<p>' | remove: '</p>' | emojify }}
          {% else %}
            <a class="news-title" href="{{ item.url | relative_url }}">{{ item.title }}</a>
          {% endif %}
        </li>
      {% endcapture %}
      {% if item_year < 2023 %}
        {% assign older_rows = older_rows | append: row %}
      {% else %}
        {% assign recent_rows = recent_rows | append: row %}
      {% endif %}
    {% endfor %}

    <div
      class="table-responsive"
      {% if include.limit and page.announcements.scrollable and news_size > 3 %}
        style="max-height: 60vw"
      {% endif %}
    >
      <ul class="news-list">
        {{ recent_rows }}
      </ul>
    </div>

    {% if older_rows != "" %}
      <details class="news-older">
        <summary>Earlier news (before 2023)</summary>
        <div class="table-responsive">
          <ul class="news-list">
            {{ older_rows }}
          </ul>
        </div>
      </details>
    {% endif %}
  {% else %}
    <p>No news so far...</p>
  {% endif %}
</div>
